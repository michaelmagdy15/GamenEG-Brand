rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      let uid = request.auth != null ? request.auth.uid : 'anonymous';
      let userPath = /databases/$(database)/documents/users/$(uid);
      return (request.auth != null && exists(userPath)) ? get(userPath).data : {
        "role": "none",
        "name": "Anonymous",
        "can_delete_payments": false,
        "can_access_settings_and_history": false,
        "can_view_global_dashboard": false
      };
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function canDeletePayments() {
      let data = getUserData();
      return request.auth != null && (
        data.role in ['super_admin', 'crm_admin', 'sales_manager', 'manager'] ||
        data.can_delete_payments == true
      );
    }

    function canAccessSettings() {
      let data = getUserData();
      return request.auth != null && (
        data.role in ['super_admin', 'crm_admin', 'sales_manager', 'manager'] ||
        data.can_access_settings_and_history == true
      );
    }

    function canViewGlobalDashboard() {
      let data = getUserData();
      return request.auth != null && (
        data.role in ['super_admin', 'crm_admin', 'sales_manager', 'manager'] ||
        data.can_view_global_dashboard == true
      );
    }

    function isAdmin() {
      let data = getUserData();
      return request.auth != null && (
        data.role in ['admin', 'super_admin', 'crm_admin', 'sales_manager', 'manager']
      );
    }

    function isSalesManager() {
      return canViewGlobalDashboard();
    }

    function isSalesRep() {
      let data = getUserData();
      return request.auth != null && (data.role == 'sales_rep' || data.role == 'rep');
    }

    // ===============================================================
    // Match Prefixed Helper Functions
    // ===============================================================
    function getMatchUserData() {
      let uid = request.auth != null ? request.auth.uid : 'anonymous';
      let userPath = /databases/$(database)/documents/match_users/$(uid);
      return (request.auth != null && exists(userPath)) ? get(userPath).data : {
        "role": "none",
        "name": "Anonymous",
        "can_delete_payments": false,
        "can_access_settings_and_history": false,
        "can_view_global_dashboard": false
      };
    }

    function canMatchAccessSettings() {
      let data = getMatchUserData();
      return request.auth != null && (
        data.role in ['super_admin', 'crm_admin', 'sales_manager', 'manager'] ||
        data.can_access_settings_and_history == true
      );
    }

    function isMatchAdmin() {
      let data = getMatchUserData();
      return request.auth != null && (
        data.role in ['admin', 'super_admin', 'crm_admin', 'sales_manager', 'manager']
      );
    }

    // ===============================================================
    // Entity Validators
    // ===============================================================
    function isValidClient(data) {
      return data.name is string && data.name.size() > 0 &&
             data.phone is string && data.phone.size() > 0 &&
             data.status in ["Lead", "Active", "Nearly Expired", "Expired", "Hold"];
    }

    function isValidPayment(data) {
      return data.clientId is string &&
             data.amount_paid is number && data.amount_paid >= 0 &&
             data.sales_rep_id is string;
    }

    function isValidMatch(data) {
      return data.maleId is string && data.maleId.size() > 0 &&
             data.maleName is string && data.maleName.size() > 0 &&
             data.femaleId is string && data.femaleId.size() > 0 &&
             data.femaleName is string && data.femaleName.size() > 0 &&
             data.status in [
               "PENDING_PROFILE_APPROVAL",
               "PENDING_PHOTO_APPROVAL",
               "PENDING_CONTACT_SHARE",
               "MATCH_ACTIVE",
               "PENDING_FEEDBACK"
             ];
    }

    // ===============================================================
    // Rules
    // ===============================================================
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /targets/{targetId} {
      allow get: if canViewGlobalDashboard() || (isSalesRep() && resource.data.sales_rep_id == request.auth.uid);
      allow list: if canViewGlobalDashboard() || isSalesRep();
      allow write: if isSalesManager();
    }

    match /userTargets/{targetId} {
      allow get: if canViewGlobalDashboard() || (isSalesRep() && resource.data.userId == request.auth.uid);
      allow list: if canViewGlobalDashboard() || isSalesRep();
      allow write: if isSalesManager();
    }

    match /payments/{paymentId} {
      allow get: if canViewGlobalDashboard() || (isSalesRep() && resource.data.sales_rep_id == request.auth.uid);
      allow list: if canViewGlobalDashboard() || isSalesRep();
      allow create: if isAuthenticated() && isValidPayment(request.resource.data);
      allow update, delete: if canDeletePayments();
    }

    match /settings/{settingId} {
      allow read: if canAccessSettings();
      allow write: if canAccessSettings();
    }

    match /auditLogs/{logId} {
      allow read: if canAccessSettings();
      allow create: if isAuthenticated();
      allow delete: if canAccessSettings();
    }

    // ===============================================================
    // Collection Group Rules
    // ===============================================================
    match /{path=**}/comments/{commentId} {
      allow read, create: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /{path=**}/interactions/{interactionId} {
      allow read, create: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /clients/{clientId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidClient(request.resource.data);
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /packages/{packageId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /coaches/{coachId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /sessions/{sessionId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /matches/{matchId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidMatch(request.resource.data);
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /attendance/{attendanceId} {
      allow read, create: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /tasks/{taskId} {
      allow read, write: if isAuthenticated();
    }

    match /counters/{counterId} {
      allow read, write: if isAuthenticated();
    }

    match /importBatches/{batchId} {
      allow read, write: if isAdmin();
    }

    // ===============================================================
    // Duplicated Rules for Prefixed collections (match_*)
    // ===============================================================
    match /match_users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) || isMatchAdmin();
      allow update: if isOwner(userId) || isMatchAdmin();
      allow delete: if isMatchAdmin();
    }

    match /match_clients/{clientId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidClient(request.resource.data);
      allow update: if isAuthenticated();
      allow delete: if isMatchAdmin();
    }

    match /match_matches/{matchId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidMatch(request.resource.data);
      allow update: if isAuthenticated();
      allow delete: if isMatchAdmin();
    }

    match /{path=**}/match_comments/{commentId} {
      allow read, create: if isAuthenticated();
      allow delete: if isMatchAdmin();
    }

    match /{path=**}/match_interactions/{interactionId} {
      allow read, create: if isAuthenticated();
      allow delete: if isMatchAdmin();
    }

    match /match_tasks/{taskId} {
      allow read, write: if isAuthenticated();
    }

    match /match_auditLogs/{logId} {
      allow read: if canMatchAccessSettings();
      allow create: if isAuthenticated();
      allow delete: if canMatchAccessSettings();
    }

    match /match_importBatches/{batchId} {
      allow read, write: if isMatchAdmin();
    }

    match /match_counters/{counterId} {
      allow read, write: if isAuthenticated();
    }

    // ===============================================================
    // GAMÉN Luxury Brand Collections
    // ===============================================================

    // Helper function to check if the user is the authenticated gamen admin
    function isGamenAdmin() {
      return request.auth != null 
             && (request.auth.token.email == 'michaelmitry13@gmail.com' || request.auth.token.email == 'admin@gamen.eg');
    }

    // Orders: anyone can create, but only with valid pending schema, mathematical security, and basic type checks
    match /gamen_orders/{orderId} {
      allow create: if request.resource.data.keys().hasAll(['orderRef', 'status', 'customer', 'items', 'totalPrice'])
                    && request.resource.data.status == 'pending'
                    && request.resource.data.totalPrice is number
                    && request.resource.data.totalPrice > 0
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0
                    && request.resource.data.customer is map
                    && request.resource.data.customer.email is string
                    && request.resource.data.customer.email.size() > 5
                    && request.resource.data.customer.email.matches('.+@.+')
                    && request.resource.data.customer.phone is string
                    && request.resource.data.customer.phone.size() >= 10;
      allow read, update, delete: if isGamenAdmin();
    }

    // Products: anyone can read, only gamen admin can write
    match /gamen_products/{productId} {
      allow read: if true;
      allow write: if isGamenAdmin();
    }

    // Product Overrides: anyone can read, only gamen admin can write (kept for backward compatibility)
    match /gamen_productOverrides/{overrideId} {
      allow read: if true;
      allow write: if isGamenAdmin();
    }

    // Mail: restrict writing to order templates to prevent open relay spam, while allowing gamen admin unrestricted creation
    match /gamen_mail/{mailId} {
      allow create: if isGamenAdmin() || (
                      request.resource.data.keys().hasAll(['to', 'message'])
                      && request.resource.data.to is list
                      && request.resource.data.to.size() <= 2
                      && ('michaelmitry13@gmail.com' in request.resource.data.to 
                          || 'info@gamen.world' in request.resource.data.to 
                          || 'admin@gamen.eg' in request.resource.data.to)
                      && request.resource.data.message is map
                      && request.resource.data.message.subject is string
                      && request.resource.data.message.subject.matches('^Order Confirmation.*')
                    );
      allow read, update, delete: if isGamenAdmin();
    }

    // Subscribers: allow public signup with valid email, restricted full access to gamen admin
    match /gamen_subscribers/{subId} {
      allow create: if request.resource.data.email is string
                    && request.resource.data.email.size() > 5
                    && request.resource.data.email.matches('.+@.+');
      allow read, update, delete: if isGamenAdmin();
    }

    // Traffic Analytics: anyone can create page view logs, but only admin can read/manage
    match /gamen_traffic/{logId} {
      allow create: if true;
      allow read, update, delete: if isGamenAdmin();
    }
  }
}